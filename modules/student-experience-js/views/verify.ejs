<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Verification · CampusOS</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="plain">
<main class="wrap narrow">

  <% if (v) { %>
  <div class="verify ok">
    <span class="kind">Verified record</span>
    <h1><%= v.subject %></h1>
    <% if (v.detail && v.detail.trim()) { %><p class="sub"><%= v.detail %></p><% } %>
    <dl>
      <div><dt>Holder</dt><dd><%= holder %></dd></div>
      <div><dt>Issued by</dt><dd><%= tenant.name %></dd></div>
      <div><dt>Credential</dt><dd><%= credential %></dd></div>
      <div><dt>Verification ID</dt><dd><code><%= v.verifyId %></code></dd></div>
      <div><dt>Issued on</dt><dd><%= issuedOn %></dd></div>
      <div><dt>Status</dt><dd class="ok-status">Verified by the issuing institution</dd></div>
    </dl>
    <div class="qr"><%- qr %></div>
    <p class="fineprint">Or open <code><%= verifyUrl %></code> directly.</p>
    <p class="fineprint">This page is the QR target. It is not one of the seven student views —
      it is what an employer sees after scanning a certificate.</p>
  </div>
  <% } else { %>
  <div class="verify bad">
    <h1>No such record</h1>
    <p>Nothing is registered against <%= verifyId %>.</p>
  </div>
  <% } %>

  <a class="btn ghost" href="/">← Back to the portal</a>
</main>
</body>
</html>
