<!doctype html>
<html lang="<%= locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CampusOS · Sign in</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="loginpage">
<main class="loginbox">
  <nav class="langswitch loginlang" aria-label="Language">
    <a href="/lang/en?back=%2Flogin" class="<%= locale === 'en' ? 'on' : '' %>"><%= t('lang.en') %></a>
    <a href="/lang/hi?back=%2Flogin" class="<%= locale === 'hi' ? 'on' : '' %>"><%= t('lang.hi') %></a>
  </nav>
  <h1><%= t('login.title') %></h1>
  <p class="sub"><%= t('login.subtitle') %></p>

  <% if (typeof error !== 'undefined' && error) { %><p class="flash bad"><%= error %></p><% } %>
  <% if (typeof flash !== 'undefined' && flash) { %><p class="flash ok"><%= flash %></p><% } %>

  <form action="/login" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="u"><%= t('login.username') %></label>
    <input id="u" name="username" type="text" autocomplete="username" required autofocus>
    <label for="p"><%= t('login.password') %></label>
    <input id="p" name="password" type="password" autocomplete="current-password" required>
    <button class="btn success" type="submit"><%= t('action.signIn') %></button>
  </form>

  <% const demoUser = (username, who) => { %>
    <form class="demobtn" action="/login/demo" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="username" value="<%= username %>">
      <button class="btn ghost" type="submit"><span class="step"><%= username %></span><span class="who"><%= who %></span></button>
    </form>
  <% } %>

  <details class="trail demo">
    <summary>Demo mode — students (one click, no password)</summary>
    <div class="hist">
      <%- demoUser('snit21cs042', 'Hari Prasad · SNIT (CSE, Sem 5)') %>
      <%- demoUser('snit21cs051', 'Divya Rajan · SNIT (CSE, Sem 5)') %>
      <%- demoUser('snit21ec017', 'Nikhil Varma · SNIT (ECE, Sem 5)') %>
      <%- demoUser('ace22ec118', 'Meera Nair · ACE (other tenant)') %>
    </div>
  </details>

  <details class="trail demo">
    <summary>Demo mode — staff (one click, no password)</summary>
    <div class="hist">
      <%- demoUser('anjali.menon', 'Faculty · CSE Sem 5 A') %>
      <%- demoUser('suresh.kumar', 'Faculty · CSE Sem 5 A (other subjects)') %>
      <%- demoUser('krishnakumar', 'HOD + Faculty · CSE') %>
      <%- demoUser('suresh.babu', 'Faculty · ECE (other department)') %>
      <%- demoUser('registrar.snit', 'Institution') %>
      <%- demoUser('exam.office', 'Examination Office') %>
      <%- demoUser('latha.iyer', 'HOD + Faculty · ACE (other tenant)') %>
    </div>
  </details>

  <details class="trail demo">
    <summary>Demo mode — statutory committees, UGC (one click, no password)</summary>
    <div class="hist">
      <%- demoUser('icc.chair', 'Internal Complaints Committee (POSH)') %>
      <%- demoUser('antiragging.chair', 'Anti-Ragging Committee') %>
      <%- demoUser('scst.cell', 'SC/ST Cell') %>
      <%- demoUser('equal.opportunity', 'Equal Opportunity Cell') %>
      <%- demoUser('rti.officer', 'RTI / Public Information Officer') %>
      <%- demoUser('ombudsperson', 'Ombudsperson (grievance appeals)') %>
    </div>
    <p class="fineprint">Each sees only the category it is the designated committee for —
      institution-wide, but nothing else about any student.</p>
  </details>

  <p class="fineprint">A student username is their roll number, lower-case.</p>
</main>
</body>
</html>
