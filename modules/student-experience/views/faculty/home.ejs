<!doctype html>
<html lang="en">
<head><%- include('head', { title: 'Home' }) %></head>
<body>
<%- include('header') %>
<main class="wrap">
  <%- include('flash') %>

  <section class="hero">
    <h1>Hello, <%= staff.name %>.</h1>
    <p class="sub"><%= roleLabels.join(' · ') %><%= staff.department ? ' · ' + staff.department : ' · Institution-wide' %></p>
  </section>

  <section>
    <div class="head"><h2><%= t('section.keyMetrics') %></h2></div>
    <div class="stats">
      <div><span>Pending actions</span><strong><%= pending %></strong></div>
      <div><span>Students in scope</span><strong><%= roster %></strong></div>
      <div><span>Classes taught</span><strong><%= classes.length %></strong></div>
      <div><span>Roles</span><strong><%= roleLabels.length %></strong></div>
    </div>
  </section>

  <section>
    <div class="head"><h2><%= t('section.waitingOnYou') %></h2><a href="/faculty/tasks"><%= t('action.seeAll') %> →</a></div>
    <div class="cards">
      <% tasks.forEach(function(t) { %><%- include('task', { t: t, back: '/faculty' }) %><% }) %>
    </div>
    <% if (tasks.length === 0) { %><p class="empty">Nothing is waiting on you right now.</p><% } %>
  </section>

  <section>
    <div class="head"><h2><%= t('section.quickActions') %></h2></div>
    <div class="quick">
      <a href="/faculty/tasks"><strong>My Tasks</strong><span>Everything waiting on you</span></a>
      <a href="/faculty/students"><strong>Students</strong><span>Your students, read-only</span></a>
      <% if (canAuthor) { %><a href="/faculty/attendance"><strong>Attendance</strong><span>Mark today's register</span></a><% } %>
      <% if (canAuthor) { %><a href="/faculty/marks"><strong>Marks &amp; Results</strong><span>Draft, then finalize</span></a><% } %>
    </div>
  </section>

  <section>
    <div class="head"><h2><%= t('section.recentActivity') %></h2><a href="/faculty/notifications"><%= t('action.allNotifications') %> →</a></div>
    <ul class="record">
      <% recent.forEach(function(n) { %>
      <li>
        <div><strong><%= n.title %></strong><p><%= n.detail %></p></div>
        <div class="right"><span><%= n.kind %></span><span class="when"><%= n.at %></span></div>
      </li>
      <% }) %>
    </ul>
    <% if (recent.length === 0) { %><p class="empty">No activity yet.</p><% } %>
  </section>
</main>
</body>
</html>
