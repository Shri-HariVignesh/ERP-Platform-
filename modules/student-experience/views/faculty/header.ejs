<input type="checkbox" id="navtoggle" class="navtoggle" aria-hidden="true">
<label for="navtoggle" class="navbtn" aria-label="Toggle navigation">☰</label>

<nav class="sidebar staff">
  <a class="brand" href="/faculty">
    <span class="mark"><%= tenant.shortName %></span>
    <span>
      <strong><%= tenant.name %></strong>
      <small>Staff · <%= roleLabels.join(' · ') %></small>
    </span>
  </a>
  <%
  // Pass 3 of the design: an entry surface exists only where this principal is authorized.
  // The server re-checks every one of these on POST — hiding a nav item is a courtesy, never the control.
  %>
  <div class="sidenav">
    <a href="/faculty" class="<%= nav === 'home' ? 'on' : '' %>"><%= t('nav.dashboard') %></a>
    <a href="/faculty/tasks" class="<%= nav === 'tasks' ? 'on' : '' %>">
      <%= t('nav.myTasks') %><% if (pending > 0) { %><span class="pill"><%= pending %></span><% } %></a>
    <a href="/faculty/students" class="<%= nav === 'students' ? 'on' : '' %>"><%= t('nav.students') %></a>
    <% if (canLeave) { %><a href="/faculty/leave" class="<%= nav === 'leave' ? 'on' : '' %>"><%= t('nav.leave') %></a><% } %>
    <% if (canInternship) { %><a href="/faculty/internship" class="<%= nav === 'internship' ? 'on' : '' %>"><%= t('nav.internship') %></a><% } %>
    <% if (canAuthor) { %><a href="/faculty/attendance" class="<%= nav === 'attendance' ? 'on' : '' %>"><%= t('nav.attendance') %></a><% } %>
    <% if (canAuthor) { %><a href="/faculty/marks" class="<%= nav === 'marks' ? 'on' : '' %>"><%= t('nav.marksResults') %></a><% } %>
    <a href="/faculty/notifications" class="<%= nav === 'notifications' ? 'on' : '' %>"><%= t('nav.notifications') %></a>
  </div>
</nav>

<header class="topbar staff">
  <div class="wrap bar">
    <span class="workspace"><%= t('workspace.staff') %></span>
    <div class="topbar-right">
      <nav class="langswitch" aria-label="Language">
        <a href="/lang/en?back=<%= encodeURIComponent(currentPath) %>" class="<%= locale === 'en' ? 'on' : '' %>"><%= t('lang.en') %></a>
        <a href="/lang/hi?back=<%= encodeURIComponent(currentPath) %>" class="<%= locale === 'hi' ? 'on' : '' %>"><%= t('lang.hi') %></a>
      </nav>
      <form class="switcher" action="/logout" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label><%= staff.name %></label>
        <button class="btn ghost" type="submit"><%= t('action.signOut') %></button>
      </form>
    </div>
  </div>
</header>
