<!doctype html>
<html lang="en">
<head><%- include('head', { title: 'Students' }) %></head>
<body>
<%- include('header') %>
<main class="wrap">
  <%- include('flash') %>

  <section class="hero">
    <h1>Students</h1>
    <p class="sub">Your students only — the classes you teach, or your department if you are
      HOD. Not the institution. Read-only: nothing on a student's profile can be edited from
      here, because every change belongs to a workflow or to the marks and attendance screens.</p>
  </section>

  <form class="filters search" action="/faculty/students" method="get">
    <input type="search" name="q" value="<%= q %>" placeholder="Search by name or roll number">
    <button type="submit" class="btn ghost">Search</button>
  </form>

  <div class="tbl-wrap"><table class="tbl">
    <thead><tr><th>Roll no</th><th>Name</th><th>Programme</th><th>Class</th><th></th></tr></thead>
    <tbody>
      <% roster.forEach(function(s) { %>
      <tr>
        <td><%= s.rollNo %></td><td><%= s.name %></td><td><%= s.program %></td>
        <td>Sem <%= s.semester %> · <%= s.section %></td>
        <td><a href="/faculty/students/<%= s.id %>">Open →</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table></div>
  <% if (roster.length === 0) { %><p class="empty">No student matches that search inside your scope.</p><% } %>
</main>
</body>
</html>
