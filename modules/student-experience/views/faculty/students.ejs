<!doctype html>
<html lang="<%= locale %>">
<head><%- include('head', { title: 'Students' }) %></head>
<body>
<%- include('header') %>
<main class="wrap">
  <%- include('flash') %>

  <section class="hero">
    <h1>Students</h1>
    <p class="sub">Your students only — the classes you teach, or your department if you are
      HOD. Not the institution. Read-only: nothing on a student's profile can be edited from
      here, because every change belongs to a workflow or to the marks and attendance screens.</p>
  </section>

  <form class="filters search" action="/faculty/students" method="get">
    <input type="search" name="q" value="<%= q %>" placeholder="Search by name or roll number">
    <button type="submit" class="btn ghost">Search</button>
  </form>

  <%
    // Every column-header / pagination link carries q forward but resets page to 1 on a
    // sort change — the alternative (keeping a stale page number against a re-sorted list)
    // silently shows the wrong rows rather than an honest page 1.
    function sortHref(field) {
      const nextDir = (sort === field && dir === 'asc') ? 'desc' : 'asc';
      return `/faculty/students?q=${encodeURIComponent(q)}&sort=${field}&dir=${nextDir}`;
    }
    function pageHref(p) {
      return `/faculty/students?q=${encodeURIComponent(q)}&sort=${sort}&dir=${dir}&page=${p}`;
    }
  %>

  <div class="tbl-wrap"><table class="tbl">
    <thead><tr>
      <th><a class="sort <%= sort === 'rollNo' ? 'on' : '' %>" href="<%= sortHref('rollNo') %>">Roll no<%= sort === 'rollNo' ? (dir === 'asc' ? ' ↑' : ' ↓') : '' %></a></th>
      <th><a class="sort <%= sort === 'name' ? 'on' : '' %>" href="<%= sortHref('name') %>">Name<%= sort === 'name' ? (dir === 'asc' ? ' ↑' : ' ↓') : '' %></a></th>
      <th>Programme</th><th>Class</th><th></th>
    </tr></thead>
    <tbody>
      <% roster.forEach(function(s) { %>
      <tr>
        <td><%= s.rollNo %></td><td><%= s.name %></td><td><%= s.program %></td>
        <td>Sem <%= s.semester %> · <%= s.section %></td>
        <td><a href="/faculty/students/<%= s.id %>">Open →</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table></div>
  <% if (roster.length === 0) { %><p class="empty">No student matches that search inside your scope.</p><% } %>

  <% if (total > 0) { %>
  <div class="pagination">
    <span class="range"><%= rangeStart %>–<%= rangeEnd %> of <%= total %></span>
    <span class="pages">
      <% if (page > 1) { %><a class="btn ghost" href="<%= pageHref(page - 1) %>">← Prev</a><% } else { %><span class="btn ghost" aria-disabled="true">← Prev</span><% } %>
      <span class="pageno">Page <%= page %> of <%= totalPages %></span>
      <% if (page < totalPages) { %><a class="btn ghost" href="<%= pageHref(page + 1) %>">Next →</a><% } else { %><span class="btn ghost" aria-disabled="true">Next →</span><% } %>
    </span>
  </div>
  <% } %>
</main>
</body>
</html>
