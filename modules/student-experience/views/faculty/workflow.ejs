<!doctype html>
<html lang="<%= locale %>">
<head><%- include('head', { title: workflow }) %></head>
<body>
<%- include('header') %>
<main class="wrap">
  <%- include('flash') %>

  <section class="hero">
    <h1><%= workflow %></h1>
    <p class="sub"><%= t('workflow.subtitle') %></p>
  </section>

  <div class="cards">
    <% tasks.forEach(function(task) { %><%- include('task', { task: task, back: back }) %><% }) %>
  </div>
  <% if (tasks.length === 0) { %><p class="empty"><%= t('workflow.emptyPrefix') %><%= locale === 'hi' ? workflow : workflow.toLowerCase() %><%= t('workflow.emptySuffix') %></p><% } %>
</main>
</body>
</html>
