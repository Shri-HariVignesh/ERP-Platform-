<!doctype html>
<html lang="<%= locale %>">
<head><%- include('head', { title: 'Attendance' }) %></head>
<body>
<%- include('header') %>
<main class="wrap">
  <%- include('flash') %>

  <section class="hero">
    <h1>Attendance</h1>
    <p class="sub">One row per student per class day — there is no per-subject register, on
      purpose. The subject you pick is what authorizes you to mark this class; the row itself
      stays a single class-day record, so the percentage keeps meaning "share of class days
      attended" and the number here is the same number the student reads.</p>
  </section>

  <%- include('picker', { pickerAction: '/faculty/attendance', pickerExtra: 'date' }) %>

  <form action="/faculty/attendance" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="clazz" value="<%= clazz.token() %>">
    <input type="hidden" name="subject" value="<%= subject %>">
    <input type="hidden" name="date" value="<%= date %>">

    <div class="tbl-wrap"><table class="tbl register">
      <thead>
        <tr><th>Roll no</th><th>Name</th><th>Present</th><th>Absent</th><th>Recorded</th><th>Attendance</th></tr>
      </thead>
      <tbody>
        <% roster.forEach(function(s) { %>
        <tr>
          <td><%= s.rollNo %></td>
          <td><%= s.name %></td>
          <td><input type="radio" name="status_<%= s.id %>" value="PRESENT"
                <%= current[s.id] === 'APPROVED_LEAVE' ? 'disabled' : '' %>
                <%= current[s.id] === 'PRESENT' ? 'checked' : '' %>></td>
          <td><input type="radio" name="status_<%= s.id %>" value="ABSENT"
                <%= current[s.id] === 'APPROVED_LEAVE' ? 'disabled' : '' %>
                <%= current[s.id] === 'ABSENT' ? 'checked' : '' %>></td>
          <td>
            <% if (current[s.id] === 'APPROVED_LEAVE') { %><span class="badge success">Approved leave</span>
            <% } else if (current[s.id] === 'SCHEDULED') { %><span class="muted">Not marked</span>
            <% } else if (!current[s.id]) { %><span class="muted">No class day</span>
            <% } else { %><span class="muted">Marked</span><% } %>
          </td>
          <td><%= pct[s.id] !== null && pct[s.id] !== undefined ? pct[s.id] + '%' : '—' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table></div>

    <p class="hint">Approved-leave days are locked. That status is written by the leave
      workflow when an HOD approves, and the register is not the place to undo a completed
      approval.</p>

    <div class="act row">
      <button class="btn success" type="submit">Save register</button>
      <span class="bulk-actions">
        Bulk: <button class="btn ghost" type="submit" name="bulk" value="PRESENT">Mark all present</button>
        <button class="btn ghost" type="submit" name="bulk" value="ABSENT">Mark all absent</button>
      </span>
    </div>
    <p class="hint">A bulk button writes the whole class immediately — including a leave-locked
      row's neighbours, never the leave-locked row itself — so the usual flow is bulk-mark the
      class, then flip the handful of exceptions with the radios and Save register.</p>
  </form>
</main>
</body>
</html>
