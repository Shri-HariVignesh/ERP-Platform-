<!doctype html>
<html lang="<%= locale %>">
<head><%- include('head', { title: t('nav.myTasks') }) %></head>
<body>
<%- include('header') %>
<main class="wrap">
  <%- include('flash') %>

  <section class="hero">
    <h1><%= t('nav.myTasks') %></h1>
    <p class="sub"><%= t('tasks.subtitle') %></p>
  </section>

  <form class="filters" action="/faculty/tasks" method="get">
    <button name="filter" value="ALL" class="<%= filter === 'ALL' ? 'on' : '' %>"><%= t('filter.all') %></button>
    <% types.forEach(function(t2) { %>
    <button name="filter" value="<%= t2 %>" class="<%= filter === t2 ? 'on' : '' %>"><%= DisplayLabels.type(t2, locale) %></button>
    <% }) %>
  </form>

  <div class="cards">
    <% tasks.forEach(function(task) { %><%- include('task', { task: task, back: back }) %><% }) %>
  </div>
  <% if (tasks.length === 0) { %><p class="empty"><%= t('tasks.empty') %></p><% } %>
</main>
</body>
</html>
