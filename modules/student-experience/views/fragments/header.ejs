<input type="checkbox" id="navtoggle" class="navtoggle" aria-hidden="true">
<label for="navtoggle" class="navbtn" aria-label="Toggle navigation">☰</label>

<nav class="sidebar">
  <a class="brand" href="/">
    <span class="mark"><%= tenant.shortName %></span>
    <span>
      <strong><%= tenant.name %></strong>
      <small><%= tenant.city %></small>
    </span>
  </a>
  <div class="sidenav">
    <a href="/" class="<%= nav === 'home' ? 'on' : '' %>"><%= t('nav.dashboard') %></a>
    <a href="/requests" class="<%= nav === 'requests' ? 'on' : '' %>"><%= t('nav.myRequests') %></a>
    <a href="/leave" class="<%= nav === 'leave' ? 'on' : '' %>"><%= t('nav.leave') %></a>
    <a href="/internship" class="<%= nav === 'internship' ? 'on' : '' %>"><%= t('nav.internship') %></a>
    <a href="/documents" class="<%= nav === 'documents' ? 'on' : '' %>"><%= t('nav.documents') %></a>
    <a href="/academic" class="<%= nav === 'academic' ? 'on' : '' %>"><%= t('nav.academic') %></a>
    <a href="/grievance" class="<%= nav === 'grievance' ? 'on' : '' %>"><%= t('nav.grievance') %></a>
  </div>
</nav>

<header class="topbar">
  <div class="wrap bar">
    <span class="workspace"><%= t('workspace.student') %></span>
    <div class="topbar-right">
      <nav class="langswitch" aria-label="Language">
        <a href="/lang/en?back=<%= encodeURIComponent(currentPath) %>" class="<%= locale === 'en' ? 'on' : '' %>"><%= t('lang.en') %></a>
        <a href="/lang/hi?back=<%= encodeURIComponent(currentPath) %>" class="<%= locale === 'hi' ? 'on' : '' %>"><%= t('lang.hi') %></a>
      </nav>
      <form class="switcher" action="/logout" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label><%= student.name %> · <%= student.rollNo %></label>
        <button class="btn ghost" type="submit"><%= t('action.signOut') %></button>
      </form>
    </div>
  </div>
</header>

<%- include('helper', { helperAudience: 'student' }) %>
