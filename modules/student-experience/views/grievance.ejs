<!doctype html>
<html lang="<%= locale %>">
<head><%- include('fragments/head', { title: 'Grievance' }) %></head>
<body>
<%- include('fragments/header') %>
<main class="wrap">
  <%- include('fragments/flash') %>

  <section class="hero">
    <h1>Grievance</h1>
    <p class="sub">Routed to the right desk by category the moment you submit — no register,
      no asking around for whose problem it is.</p>
  </section>

  <form class="panel" action="/grievance" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2>Raise a grievance</h2>
    <% if (errors && errors.length) { %><p class="errs"><% errors.forEach(function(e) { %><span><%= e %></span><% }) %></p><% } %>

    <div class="grid">
      <label>Category
        <select name="category">
          <% categories.forEach(function(cat) { %>
          <option value="<%= cat %>" <%= form.category === cat ? 'selected' : '' %>><%= DisplayLabels.category(cat, locale) %></option>
          <% }) %>
        </select>
      </label>
      <label class="check">
        <input type="checkbox" name="anonymous" <%= form.anonymous ? 'checked' : '' %>> Submit anonymously
      </label>
    </div>
    <label>Subject <input type="text" name="subject" value="<%= form.subject %>" required></label>
    <label>What happened <textarea name="description" rows="4" required><%= form.description %></textarea></label>
    <p class="hint">Ragging, sexual harassment, SC/ST discrimination, equal-opportunity and RTI
      categories go to a dedicated statutory committee, not your class advisor. Those are
      confidential by design: only that committee and the Institution can ever see them, no
      matter who else can see your other requests.</p>
    <button class="btn action" type="submit">Submit grievance</button>
  </form>

  <details class="trail">
    <summary>Institutional committees &amp; contacts (UGC-mandated)</summary>
    <ul class="hist">
      <li><span class="step">Grievance Redressal Committee</span><span class="who">Dr. Latha Pillai, Registrar · registrar@snit.ac.in</span></li>
      <li><span class="step">Anti-Ragging Committee</span><span class="who">Dr. Ravi Nair · antiragging@snit.ac.in</span></li>
      <li><span class="step">Internal Complaints Committee (ICC)</span><span class="who">Prof. Meena Pillai · icc@snit.ac.in</span></li>
      <li><span class="step">SC/ST Cell</span><span class="who">Prof. Ajitha Kumari · scstcell@snit.ac.in</span></li>
      <li><span class="step">Equal Opportunity Cell</span><span class="who">Prof. Deepa Thomas · eoc@snit.ac.in</span></li>
      <li><span class="step">RTI / Public Information Officer</span><span class="who">Vinod Menon · rti@snit.ac.in</span></li>
      <li><span class="step">Ombudsperson</span><span class="who">Justice (Retd.) K. Balakrishnan · ombudsperson@snit.ac.in</span></li>
    </ul>
    <p class="fineprint">A resolved grievance can be escalated to the Ombudsperson from its card
      below if the committee's decision does not resolve the matter to your satisfaction.</p>
  </details>

  <div class="cards">
    <% cards.forEach(function(c) { %><%- include('fragments/card', { c: c, back: '/grievance' }) %><% }) %>
  </div>
  <% if (cards.length === 0) { %><p class="empty">No grievances raised.</p><% } %>
</main>
</body>
</html>
